#pragma code_page(65001)
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @IBSTART_VERSION_COMMA@
 PRODUCTVERSION @IBSTART_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName", "IBStart open-source contributors\0"
            VALUE "FileDescription", "ИБ Старт — менеджер запусков информационных баз\0"
            VALUE "FileVersion", "@IBSTART_FILE_VERSION@\0"
            VALUE "InternalName", "IBStart\0"
            VALUE "LegalCopyright", "MIT License\0"
            VALUE "OriginalFilename", "IBStart.exe\0"
            VALUE "ProductName", "IBStart (ИБ Старт)\0"
            VALUE "ProductVersion", "@IBSTART_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END

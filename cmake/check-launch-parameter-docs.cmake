get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(data "${root}/src/core/launcher/parameter_versions.inc")
file(READ "${data}" identifiers)
# Git may check text files out with CRLF on Windows. Hash the same normalized
# UTF-8 text used by the documentation renderer, independent of checkout EOL.
string(REPLACE "\r\n" "\n" identifiers "${identifiers}")
string(SHA256 digest "${identifiers}")
file(READ "${root}/docs/launch-parameter-versions.md" document)
string(FIND "${document}" "`${digest}`" digest_position)
if(digest_position EQUAL -1)
  message(FATAL_ERROR "Launch parameter version documentation is stale. Run tools/update-launch-parameter-versions.py --docs-only")
endif()
string(REGEX MATCHALL "L\"8\\.[35]\\.[0-9]+\"," versions "${identifiers}")
list(LENGTH versions count)
if(NOT count EQUAL 24)
  message(FATAL_ERROR "Expected 24 verified platform families, got ${count}")
endif()
foreach(version IN LISTS versions)
  string(REGEX REPLACE "L\"([^\"]+)\"," "\\1" version "${version}")
  string(FIND "${document}" "| ${version} |" position)
  string(FIND "${document}" "| ${version}* |" preview_position)
  if(position EQUAL -1 AND preview_position EQUAL -1)
    message(FATAL_ERROR "Version ${version} missing from version documentation")
  endif()
endforeach()
message(STATUS "Launch parameter version data and documentation agree")
